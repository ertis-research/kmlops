# kmlops configuration. Copy this file to .env and fill in your values.
# Required variables have no default: kmlops will not start without them.
# k8s/deploy.sh uses this same file to deploy kmlops to Kubernetes.

# ---- Deployment (only used by k8s/deploy.sh, never copied into the cluster config) ----
# kmlops image to deploy (required by k8s/deploy.sh)
KMLOPS_IMAGE=your-registry/your-project/kmlops:latest
# Registry credentials: the script creates the "kmlops-registry-creds" pull Secret from them.
# They need pull permission on the registry project of KMLOPS_IMAGE (use a robot account).
# Required the first time: deploy.sh fails if the "kmlops-registry-creds" Secret does not exist
# and these are not set (an old "model-registry-creds" is not reused). Once it exists, they can be omitted.
# REGISTRY_SERVER=your-registry
# REGISTRY_USERNAME=robot$your-project+name
# REGISTRY_PASSWORD=your_robot_token

# ---- MinIO (required) --------------------------------------------------------
MINIO_URL=minio.your-domain.com
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
BUCKET_NAME=your_bucket_name
# Use HTTPS for MinIO (default: true)
# MINIO_SECURE=true
# Secret the training Jobs read the MinIO credentials from (secretKeyRef) instead of getting them
# in plain text in the Job spec. Without it kmlops logs a warning at startup. k8s/deployment.yaml
# already sets it, so k8s/deploy.sh ignores this variable.
# MINIO_CREDENTIALS_SECRET=kmlops-minio-credentials
# Keys of that Secret holding the access key and the secret key (default: MINIO_ACCESS_KEY / MINIO_SECRET_KEY)
# MINIO_CREDENTIALS_ACCESS_KEY_KEY=MINIO_ACCESS_KEY
# MINIO_CREDENTIALS_SECRET_KEY_KEY=MINIO_SECRET_KEY

# ---- Kubernetes ---------------------------------------------------------------
# Namespace where kmlops is deployed and training Jobs run (required)
KUBERNETES_NAMESPACE=your_namespace
# Kubeconfig, only used when kmlops runs outside the cluster (default: ~/.kube/config)
# KUBERNETES_CONFIG_PATH=~/.kube/config
# Image of the training Jobs (default: ludwigai/ludwig:latest)
# TRAINING_IMAGE=ludwigai/ludwig:latest
# Kubernetes removes finished training Jobs after this many seconds (default: 60)
# TRAINING_JOB_TTL_SECONDS=60
# Retries of a failed training pod (default: 1)
# TRAINING_JOB_BACKOFF_LIMIT=1
# Versions of mlflow and minio installed in the training pod (default: those of requirements.txt)
# TRAINING_MLFLOW_VERSION=3.18.0
# TRAINING_MINIO_VERSION=7.2.20
# Extra pip packages for the training pod: comma-separated name==version entries (default: none)
# TRAINING_PIP_EXTRA_PACKAGES=scikit-learn==1.5.2,pandas==2.2.3

# ---- MLflow (optional: without it only local trainings are tracked) ----------
MLFLOW_TRACKING_URI=http://your-mlflow-host:5000

# ---- Training status ------------------------------------------------------------
# How often active trainings are refreshed (default: 10)
# STATUS_POLL_INTERVAL_SECONDS=10
# A training still queued/launching_job after this many seconds is marked failed (default: 300)
# LAUNCH_TIMEOUT_SECONDS=300

# ---- Training store ---------------------------------------------------------------
# sqlite (a file inside the container, default) or postgres
DB_BACKEND=sqlite

# SQLite file (default: /data/kmlops.db, the volume mounted by k8s/deployment.yaml).
# This local path is for development only: k8s/deploy.sh does not copy it to the cluster.
SQLITE_PATH=./data/kmlops.db

# PostgreSQL, only when DB_BACKEND=postgres (the database must exist)
# POSTGRES_HOST=your-postgres-host
# POSTGRES_PORT=5432
# POSTGRES_DB=kmlops
# POSTGRES_USER=kmlops
# POSTGRES_PASSWORD=your_password
